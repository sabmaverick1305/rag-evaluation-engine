# PostgreSQL / pgvector
DATABASE_URL=postgresql://graphrag:localdevonly@127.0.0.1:5432/graphrag

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=production-graph-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -------------------------------------------------------------
# AWS Bedrock & Bedrock Agent Core Configuration
# -------------------------------------------------------------
# AWS Credentials & Region
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# LLM Provider: "local" (uses local Qwen + LoRA) or "bedrock" (uses AWS Bedrock foundation model)
LLM_PROVIDER=bedrock

# AWS Bedrock Foundation Model ID (e.g. Claude 3.5 Sonnet, Claude 3 Haiku, Amazon Nova Pro)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOKENS=1024

# AWS Bedrock Agent Core Configuration
# Agent Mode: "orchestrator" (uses hybrid orchestrator) or "bedrock_agent" (delegates to AWS Bedrock Agent Core)
AGENT_MODE=bedrock_agent
BEDROCK_AGENT_ID=your-bedrock-agent-id
BEDROCK_AGENT_ALIAS_ID=TSTALIASID
